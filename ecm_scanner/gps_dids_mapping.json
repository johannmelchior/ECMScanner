  "hierarchical_structure": {
    "identity_dids": ["0xF186", "0xF18C", "0xF1F0", "0xF100", "0xF101"],
    "position_dids": ["0xCF05", "0xCF06", "0xCF07"],
    "motion_dids": ["0xCF08", "0xCF0B"],
    "quality_dids": ["0xCF00", "0xCF01", "0xCF03", "0xCF04"],
    "time_dids": ["0xCF0C"]
  },
  "interpretation_note": "DIDs 0xCF05-0xCF07 are candidates for position data. 0xCF06/0xCF07 appear to be latitude/longitude based on response value ranges (small numbers 0x03, 0x07 suggest angle indication). 0xCF05 contains altitude data based on signed integer responses and typical (00 00, FF F5 = -11, FF F7 = -9 in meters)."
}
